# Copy to .env and fill in a real password. .env is git-ignored; this file is not.
POSTGRES_DB=hobby_inventory
POSTGRES_USER=hobby
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=8080
# Optional: a Steam Web API key for the Video games hobby (steamcommunity.com/dev/apikey)
STEAM_API_KEY=
# Optional: your Discogs personal access token for the Vinyl hobby (Discogs > Settings > Developers > Generate new token)
DISCOGS_TOKEN=
# Optional: a Last.fm API account for scrobbling records you play (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
LASTFM_API_SECRET=
