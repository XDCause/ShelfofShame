# Secrets
.env

# Database backups (contain your data)
backups/
*.dump

# Test run leftovers (.tested = "passed on this code" stamps + logs, per copy)
.pytest_cache/
e2e/out/
.tested/

# Python (later stages)
__pycache__/
*.pyc
.venv/

# Node (web)
node_modules/
dist/

# Excel lock files
~$*

# Copied from node_modules at build time (web/scripts/copy-excalidraw-fonts.js)
web/public/fonts/

# Uploaded videos (your own files)
media/
