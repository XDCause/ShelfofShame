# Secrets
.env

# Database backups (contain your data)
backups/
*.dump

# Test run leftovers (.tested = "passed on this code" stamps + logs, per copy)
.pytest_cache/
e2e/out/
.e2e/
.tested/

# Python (later stages)
__pycache__/
*.pyc
.venv/

# Node (web)
node_modules/
dist/

# Excel lock files
~$*

# Copied from node_modules at build time (web/scripts/copy-excalidraw-fonts.js)
web/public/fonts/

# Uploaded videos (your own files)
media/
api/coverage.txt
api/.coverage

# HTTPS certificate and key for this copy (make-cert.ps1; the CA itself lives in %USERPROFILE%\.offtheclock)
certs/

# The showcase (showcase.ps1): screenshots of every version, and its working folder
showcase/
.showcase/

# Data that is not ours to publish (e.g. the sudoku library: data/sudoku/hardest-published.tsv). Loaded into the database.
/data/
# The sudoku search's results (tools/sudoku-search): brought to the app PC by hand, loaded into the database.
/tools/sudoku-search/found.tsv
