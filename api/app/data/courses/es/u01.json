    {
      "id": "es-u01-l3",
      "title": "What's your name?",
      "notes": "To give your name, say **me llamo** + name: literally 'I call myself'. **Soy Ana** (I'm Ana) works too.\nTo ask a friend or someone your age: **¿Cómo te llamas?** To ask politely (an older person, at work, a stranger): **¿Cómo se llama usted?** - **usted** is the formal 'you'; unit 2 says more.\nOn meeting: **mucho gusto** (a pleasure), or **encantado** if you're a man and **encantada** if you're a woman - the word describes you, so it matches you. The reply: **igualmente** (likewise).",
      "items": [
        {"es": "me llamo", "en": "my name is", "kind": "phrase", "accept_en": ["I'm called", "I call myself"]},
        {"es": "¿cómo te llamas?", "en": "what's your name?", "kind": "phrase", "accept_en": ["what is your name?"], "note": "Informal: a friend, a child, someone your age."},
        {"es": "¿cómo se llama usted?", "en": "what's your name? (formal)", "kind": "phrase", "accept_en": ["what is your name?", "what's your name?"], "note": "Polite: a stranger, an older person."},
        {"es": "soy", "en": "I am", "kind": "phrase", "accept_en": ["I'm"]},
        {"es": "mucho gusto", "en": "nice to meet you", "kind": "phrase", "accept_en": ["pleased to meet you", "a pleasure"]},
        {"es": "encantado", "en": "pleased to meet you (said by a man)", "kind": "word", "accept_en": ["pleased to meet you", "nice to meet you", "delighted"]},
        {"es": "encantada", "en": "pleased to meet you (said by a woman)", "kind": "word", "accept_en": ["pleased to meet you", "nice to meet you", "delighted"]},
        {"es": "igualmente", "en": "likewise", "kind": "word", "accept_en": ["you too", "same here", "same to you"]},
        {"es": "usted", "en": "you (formal)", "kind": "word", "accept_en": ["you"]}
      ],
      "sentences": [
        {"es": "Hola, me llamo Ana.", "en": "Hello, my name is Ana.", "focus": "llamo", "accept_en": ["Hi, my name is Ana.", "Hi, I'm Ana.", "Hello, I'm called Ana."]},
        {"es": "¿Cómo te llamas?", "en": "What's your name?", "focus": "llamas", "accept_en": ["What is your name?"]},
        {"es": "Me llamo Carlos. ¿Y tú?", "en": "My name is Carlos. And you?", "focus": "Me", "accept_en": ["I'm Carlos. And you?", "My name's Carlos. And you?"]},
        {"es": "Soy Ana, mucho gusto.", "en": "I'm Ana, nice to meet you.", "focus": "gusto", "accept_en": ["I'm Ana, pleased to meet you."]},
