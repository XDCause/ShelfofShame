        {"es": "el equipo", "en": "the team", "kind": "word", "gender": "m", "accept_en": ["team", "the equipment"]},
        {"es": "el pasatiempo", "en": "the hobby", "kind": "word", "gender": "m", "accept": ["la afición", "el hobby"], "accept_en": ["hobby", "the pastime"]},
        {"es": "el cine", "en": "the cinema", "kind": "word", "gender": "m", "accept_en": ["the movies", "cinema", "the pictures"]},
        {"es": "el museo", "en": "the museum", "kind": "word", "gender": "m", "accept_en": ["museum", "the gallery"]},
        {"es": "el arte", "en": "art", "kind": "word", "gender": "m", "accept_en": ["the art"]},
