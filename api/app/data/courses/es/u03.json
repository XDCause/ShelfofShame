  "goal": "Count to twenty, give your age and phone number, and say what there is with hay.",
  "lessons": [
    {
      "id": "es-u03-l1",
      "title": "Zero to ten",
      "notes": "The first numbers are worth learning cold - everything else is built on them.\n**cero, uno, dos, tres, cuatro, cinco, seis, siete, ocho, nueve, diez**\nSum them with **y** (and) and **son** (are): **Dos y dos son cuatro** - 'two and two are four'.\nSay every vowel clearly: Spanish vowels are short and never fade into 'uh'. **Seis** rhymes with 'case', **nueve** is 'NWEH-veh'.",
      "items": [
        {"es": "cero", "en": "zero", "kind": "word", "accept_en": ["0", "nought"]},
        {"es": "uno", "en": "one", "kind": "word", "accept_en": ["1"]},
        {"es": "dos", "en": "two", "kind": "word", "accept_en": ["2"]},
        {"es": "tres", "en": "three", "kind": "word", "accept_en": ["3"]},
        {"es": "cuatro", "en": "four", "kind": "word", "accept_en": ["4"]},
        {"es": "cinco", "en": "five", "kind": "word", "accept_en": ["5"]},
        {"es": "seis", "en": "six", "kind": "word", "accept_en": ["6"]},
        {"es": "siete", "en": "seven", "kind": "word", "accept_en": ["7"]},
        {"es": "ocho", "en": "eight", "kind": "word", "accept_en": ["8"]},
        {"es": "nueve", "en": "nine", "kind": "word", "accept_en": ["9"]},
        {"es": "diez", "en": "ten", "kind": "word", "accept_en": ["10"]},
        {"es": "el número", "en": "the number", "kind": "word", "gender": "m", "accept_en": ["number"]}
      ],
      "sentences": [
        {"es": "Uno, dos, tres, cuatro.", "en": "One, two, three, four.", "focus": "tres", "accept_en": ["1, 2, 3, 4."]},
        {"es": "Dos y dos son cuatro.", "en": "Two and two are four.", "focus": "cuatro", "accept_en": ["Two plus two is four.", "Two and two make four.", "Two plus two equals four."]},
        {"es": "Cinco y cinco son diez.", "en": "Five and five are ten.", "focus": "diez", "accept_en": ["Five plus five is ten.", "Five and five make ten."]},
        {"es": "Tres y cuatro son siete.", "en": "Three and four are seven.", "focus": "siete", "accept_en": ["Three plus four is seven.", "Three and four make seven."]},
        {"es": "Seis y tres son nueve.", "en": "Six and three are nine.", "focus": "nueve", "accept_en": ["Six plus three is nine.", "Six and three make nine."]},
        {"es": "Ocho y dos son diez.", "en": "Eight and two are ten.", "focus": "Ocho", "accept_en": ["Eight plus two is ten.", "Eight and two make ten."]},
        {"es": "El número es seis.", "en": "The number is six.", "focus": "número"},
        {"es": "Cero y cinco son cinco.", "en": "Zero and five are five.", "focus": "Cero", "accept_en": ["Zero plus five is five."]},
        {"es": "Uno y uno son dos.", "en": "One and one are two.", "focus": "Uno", "accept_en": ["One plus one is two.", "One and one make two."]}
      ]
