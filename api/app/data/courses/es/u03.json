        {"es": "¿Cuál es tu número de celular?", "en": "What's your mobile number?", "focus": "celular", "accept_en": ["What is your mobile number?", "What's your cell phone number?"]},
        {"es": "¿Cuántos estudiantes hay en la clase?", "en": "How many students are there in the class?", "focus": "hay", "accept_en": ["How many students are in the class?"]},
